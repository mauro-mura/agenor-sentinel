<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>dev.agenor.sentinel</groupId>
    <artifactId>agenor-sentinel</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Agenor Sentinel</name>
    <description>A distributed availability monitor built on Agenor, from the outside.</description>

    <modules>
        <module>sentinel-common</module>
        <module>sentinel-probe</module>
        <module>sentinel-coordinator</module>
        <module>sentinel-alerter</module>
        <module>sentinel-fixtures</module>
        <module>sentinel-reconcile</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- The only Agenor version this project uses: a release from Maven Central, never a SNAPSHOT. -->
        <agenor.version>0.39.0</agenor.version>
        <!--
            spring-boot-starter.md asks for these two overrides "up to Boot 4.0.8". Boot 4.0.9 still
            manages Jackson 2.21.7 and Lettuce 6.8.2, so they are needed here as well.
        -->
        <jackson-2-bom.version>2.22.1</jackson-2-bom.version>
        <lettuce.version>7.5.1.RELEASE</lettuce.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.agenor.sentinel</groupId>
                <artifactId>sentinel-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.agenor</groupId>
                <artifactId>agenor-spring-boot-starter</artifactId>
                <version>${agenor.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.agenor</groupId>
                <artifactId>agenor-adapters</artifactId>
                <version>${agenor.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.agenor</groupId>
                <artifactId>agenor-adapters-persistence</artifactId>
                <version>${agenor.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
