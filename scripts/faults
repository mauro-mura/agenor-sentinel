#!/usr/bin/env -S python3 -I
"""Causes failures on purpose (CRITERION §2), chosen by a seeded random generator, and records
each one as a CSV row: when, to which container, and which agent and node died and replaced it.

    scripts/faults --regime 3 --seed 3 --count 5 --interval 120 --out faults.csv
    scripts/faults --regime 3 --victims probe,coordinator,alerter --seed 3 --count 6 --interval 120 --out faults.csv

Regime 1 (scale up and down): odd faults scale the probes up to --high, even faults back down to
--low, with docker compose --scale. Scaling down stops the highest-numbered containers with
SIGTERM, as compose does, then lets compose remove them; one row per probe added or removed. The
seed plays no part: compose decides which containers go.

Regime 2 (rolling upgrade): each fault replaces every probe, one at a time. A probe's container is
stopped with SIGTERM and started again, which gives it a new agent id and a new node id, and the
next probe is not touched until the replacement is running. One row per probe replaced; the order
is shuffled by the seed.

Regime 3 (death without goodbye): the JVM of a container is killed with SIGKILL from inside the
container. The container runs under an init process (compose.yml, init: true), so it exits on its
own and restart: unless-stopped brings it back with a new node id; a probe also gets a new agent
id, while the coordinator and the alerter keep theirs ('coordinator', 'alerter'). --victims
names the roles that may die, probe by default; each fault picks one role with the seed, and for a
probe, one of the probe containers. With --victims probe the choices are the ones earlier runs made
with the same seed.

Regime 4 (the broker comes back empty): Valkey is stopped, left down for --down seconds (10 by
default), and started again. compose.yml runs it with no persistence, so it starts with no keys:
no streams, no consumer groups. The row records when it was stopped (killed_at), when it answered
PING again (replacement_running_at), and how many keys it loaded on start (broker_keys_loaded,
from INFO persistence), which must be 0 for the fault to be the one CRITERION §2 describes.

An orderly stop waits up to --stop-timeout seconds (30 by default, more than the agent's own 10 s
stop timeout) before the container runtime falls back to SIGKILL. The container's exit code is
recorded: 143 is the JVM leaving on SIGTERM, 137 a SIGKILL. killed_at is when the signal was sent,
whatever the regime.

The agent id of a container is read from Agenor's lifecycle log line ("Agent lifecycle: <id>
STARTING -> RUNNING"); its node id from the agent's row in agenor_agents, which a killed probe
leaves behind. Standard library only; needs the docker CLI and the compose stack of this
repository.
"""

import argparse
import concurrent.futures
import csv
import datetime
import random
import re
import subprocess
import sys
import time

LIFECYCLE = re.compile(r"Agent lifecycle: (\S+) STARTING -> RUNNING")
COLUMNS = ["seed", "n", "regime", "action", "container", "victim_agent_id", "victim_node_id",
           "killed_at", "exit_code", "stop_seconds", "replacement_agent_id", "replacement_node_id",
           "replacement_running_at", "broker_keys_loaded"]


def run(*args):
    return subprocess.run(args, check=True, capture_output=True, text=True).stdout


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def containers(service):
    ids = run("docker", "compose", "ps", "-q", service).split()
    names = [run("docker", "inspect", "-f", "{{.Name}}", i).strip().lstrip("/") for i in ids]
    # By compose's number, so that probe_10 sorts after probe_9.
    return sorted(names, key=lambda name: int(name.rsplit("_", 1)[1]))


def probe_containers():
    return containers("probe")


def starts(container):
    """The agent id of every start in the container's log, oldest first. The log outlives a restart."""
    logs = subprocess.run(["docker", "logs", container], capture_output=True, text=True)
    return LIFECYCLE.findall(logs.stdout + logs.stderr)


def running_agent(container):
    """The agent id of the latest start in the container's log, or None before the first start."""
    found = starts(container)
    return found[-1] if found else None


def node_of(agent_id):
    out = run("docker", "compose", "exec", "-T", "postgres", "psql", "-U", "sentinel", "-d", "sentinel",
              "-At", "-c", f"SELECT node_id FROM agenor_agents WHERE agent_id = '{agent_id}'")
    return out.strip() or None


def wait_for_new_agent(container, starts_before, timeout):
    """The agent id of the first start after the first starts_before ones, and when; or Nones.

    Counted by starts, not compared by id: a probe has a new agent id on every start, but the
    coordinator and the alerter keep theirs ('coordinator', 'alerter')."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        time.sleep(1)
        found = starts(container)
        if len(found) > starts_before:
            return found[starts_before], now()
    print(f"{container} reported no new agent within {timeout} s", file=sys.stderr)
    return None, None


def stop(container, timeout):
    """Stops the container with SIGTERM; (signal sent at, exit code, seconds the stop took)."""
    sent_at, started = now(), time.monotonic()
    run("docker", "stop", "-t", str(int(timeout)), container)
    took = time.monotonic() - started
    code = run("docker", "inspect", "-f", "{{.State.ExitCode}}", container).strip()
    return sent_at, code, f"{took:.1f}"


def replace_probe(container, seed, n, args):
    before = starts(container)
    victim = before[-1] if before else None
    victim_node = node_of(victim) if victim else None
    killed_at, code, took = stop(container, args.stop_timeout)
    run("docker", "start", container)
    replacement, running_at = wait_for_new_agent(container, len(before), args.restart_timeout)
    return dict(seed=seed, n=n, regime=2, action="SIGTERM probe, then start", container=container,
                victim_agent_id=victim, victim_node_id=victim_node, killed_at=killed_at,
                exit_code=code, stop_seconds=took, replacement_agent_id=replacement,
                replacement_node_id=node_of(replacement) if replacement else None,
                replacement_running_at=running_at)


def rolling_upgrade(rng, seed, n, args):
    probes = probe_containers()
    rng.shuffle(probes)
    return [replace_probe(container, seed, n, args) for container in probes]


def scale(rng, seed, n, args):
    before = probe_containers()
    if n % 2 == 1:
        run("docker", "compose", "up", "-d", "--no-deps", "--no-recreate", "--scale", f"probe={args.high}", "probe")
        added_at = now()
        rows = []
        for container in (c for c in probe_containers() if c not in before):
            agent, running_at = wait_for_new_agent(container, 0, args.restart_timeout)
            rows.append(dict(seed=seed, n=n, regime=1, action=f"scale up to {args.high}", container=container,
                             killed_at=added_at, replacement_agent_id=agent,
                             replacement_node_id=node_of(agent) if agent else None,
                             replacement_running_at=running_at))
        return rows
    # Compose removes the highest-numbered containers; they are stopped first, in parallel, so
    # that each stop is recorded before compose removes the container and its log.
    leaving = before[args.low:]
    victims = {c: running_agent(c) for c in leaving}
    nodes = {c: node_of(a) if a else None for c, a in victims.items()}
    with concurrent.futures.ThreadPoolExecutor(len(leaving) or 1) as pool:
        stops = dict(zip(leaving, pool.map(lambda c: stop(c, args.stop_timeout), leaving)))
    run("docker", "compose", "up", "-d", "--no-deps", "--no-recreate", "--scale", f"probe={args.low}", "probe")
    return [dict(seed=seed, n=n, regime=1, action=f"scale down to {args.low}", container=c,
                 victim_agent_id=victims[c], victim_node_id=nodes[c], killed_at=stops[c][0],
                 exit_code=stops[c][1], stop_seconds=stops[c][2]) for c in leaving]


def restart_broker(rng, seed, n, args):
    killed_at, started = now(), time.monotonic()
    run("docker", "compose", "stop", "valkey")
    took = f"{time.monotonic() - started:.1f}"
    code = run("docker", "inspect", "-f", "{{.State.ExitCode}}", run("docker", "compose", "ps", "-q", "valkey").strip()).strip()
    time.sleep(args.down)
    run("docker", "compose", "start", "valkey")
    running_at, loaded = None, None
    deadline = time.monotonic() + args.restart_timeout
    while time.monotonic() < deadline:
        ping = subprocess.run(["docker", "compose", "exec", "-T", "valkey", "valkey-cli", "PING"],
                              capture_output=True, text=True)
        if ping.stdout.strip() == "PONG":
            running_at = now()
            info = run("docker", "compose", "exec", "-T", "valkey", "valkey-cli", "INFO", "persistence")
            loaded = next(l.split(":")[1].strip() for l in info.splitlines() if l.startswith("rdb_last_load_keys_loaded:"))
            break
        time.sleep(0.2)
    return [dict(seed=seed, n=n, regime=4, action=f"valkey stopped, down {args.down:g} s, started",
                 container="valkey", killed_at=killed_at, exit_code=code, stop_seconds=took,
                 replacement_running_at=running_at, broker_keys_loaded=loaded)]


def kill_jvm(rng, seed, n, args):
    role = rng.choice(args.victims) if len(args.victims) > 1 else args.victims[0]
    candidates = containers(role)
    container = rng.choice(candidates) if role == "probe" else candidates[0]
    before = starts(container)
    victim = before[-1] if before else None
    victim_node = node_of(victim) if victim else None
    killed_at = now()
    run("docker", "exec", container, "sh", "-c", "kill -9 $(pgrep -x java)")

    replacement, running_at = wait_for_new_agent(container, len(before), args.restart_timeout)
    return [dict(seed=seed, n=n, regime=3, action=f"SIGKILL {role} JVM", container=container,
                 victim_agent_id=victim, victim_node_id=victim_node, killed_at=killed_at,
                 replacement_agent_id=replacement,
                 replacement_node_id=node_of(replacement) if replacement else None,
                 replacement_running_at=running_at)]


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--regime", type=int, choices=[1, 2, 3, 4], required=True)
    parser.add_argument("--seed", type=int, required=True)
    parser.add_argument("--count", type=int, required=True)
    parser.add_argument("--interval", type=float, required=True, help="seconds from one fault to the next")
    parser.add_argument("--restart-timeout", type=float, default=120)
    parser.add_argument("--stop-timeout", type=float, default=30, help="regimes 1 and 2")
    parser.add_argument("--down", type=float, default=10, help="regime 4: seconds the broker stays down")
    parser.add_argument("--low", type=int, default=2, help="regime 1: probes after scaling down")
    parser.add_argument("--high", type=int, default=5, help="regime 1: probes after scaling up")
    parser.add_argument("--victims", default="probe",
                        help="regime 3: comma-separated roles that may die, among probe, coordinator, alerter")
    parser.add_argument("--out", required=True, help="CSV file, one row per fault")
    args = parser.parse_args()
    args.victims = args.victims.split(",")
    unknown = set(args.victims) - {"probe", "coordinator", "alerter"}
    if unknown:
        parser.error(f"unknown victims: {', '.join(sorted(unknown))}")

    rng = random.Random(args.seed)
    with open(args.out, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=COLUMNS)
        writer.writeheader()
        for n in range(1, args.count + 1):
            started = time.monotonic()
            fault = {1: scale, 2: rolling_upgrade, 3: kill_jvm, 4: restart_broker}[args.regime]
            for row in fault(rng, args.seed, n, args):
                writer.writerow(row)
                f.flush()
                print(f"#{n} {row['killed_at']} {row['action']} {row['container']}: "
                      f"node {row.get('victim_node_id')} gone (exit {row.get('exit_code') or '-'}), "
                      f"node {row.get('replacement_node_id')} running at {row.get('replacement_running_at')}")
            if n < args.count:
                time.sleep(max(0.0, args.interval - (time.monotonic() - started)))


if __name__ == "__main__":
    main()
